# Intel — environment configuration example.
# Copy to .env and fill in your values. NEVER commit .env with real keys.

# PostgreSQL (required for graph queries)
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/intel?schema=public
PRISMA_SKIP_ENGINE_DOWNLOAD=true

# Select which reasoning model powers Intel's answer generation.
# Valid values: mock | anthropic | ollama | openrouter
INTEL_PROVIDER=ollama

# --- Ollama (local, preferred development provider) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_MS=60000

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_MS=60000

# --- OpenRouter (optional cloud provider) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-70b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000
