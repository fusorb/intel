# Intel — environment configuration example.
# Copy to .env and fill in your values. NEVER commit .env with real keys.

# PostgreSQL (required for graph queries)
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/intel?schema=public
PRISMA_SKIP_ENGINE_DOWNLOAD=true

# Select which reasoning model powers Intel's answer generation.
# Valid values: mock | anthropic | ollama | openrouter | openai
INTEL_PROVIDER=ollama

# --- Ollama (local, preferred development provider) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_MS=60000

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_MS=60000

# --- OpenRouter (optional cloud provider) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-70b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000

# --- Generic OpenAI-compatible provider (free options) ---
# Point OPENAI_BASE_URL at any OpenAI-compatible endpoint and it just works:
#   Groq          https://api.groq.com/openai/v1
#   Cerebras      https://api.cerebras.ai/v1
#   Mistral       https://api.mistral.ai/v1
#   Gemini        https://generativelanguage.googleapis.com/v1beta/openai/
#   GitHub Models https://models.github.ai/inference
#   Local (LM Studio / llama.cpp / vLLM / Ollama's own /v1)  http://localhost:1234/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=60000

# --- apps/api (internal, read-only HTTP service) ---
# Auth: token (single-user bearer, default) | cloudflare-access | none (dev only).
INTEL_API_AUTH=token
INTEL_API_TOKEN=change-me-to-a-long-random-string
# INTEL_API_CORS_ORIGIN=https://intel.fusorb.com
# INTEL_API_AUTH_HEADER=cf-access-authenticated-user-email   # cloudflare-access mode only
# INTEL_API_RATE_LIMIT_MAX=60
# INTEL_API_RATE_LIMIT_WINDOW_MS=60000
# INTEL_API_TIMEOUT_MS=120000
# INTEL_API_MAX_BODY_BYTES=16384
# INTEL_API_AGENT_MAX_STEPS=5
# PORT=8787
# HOST=0.0.0.0
