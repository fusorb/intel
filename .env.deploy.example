# Deployment env for `docker compose --env-file .env.deploy`. Never commit the real file.

# Postgres password for the `intel` user (compose substitutes this into DATABASE_URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token.
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# Edge auth: trust the identity header Cloudflare Access injects.
INTEL_API_AUTH=cloudflare-access

# Provider: self-hosted Ollama (no egress). Run the compose `ollama` profile too.
INTEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest
